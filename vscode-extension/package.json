{
  "name": "vscode",
  "displayName": "NanoClaw",
  "description": "Run NanoClaw agents on this machine and work with them from the editor.",
  "version": "0.16.0",
  "publisher": "nanoclaw",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nanoclaw.connect",
        "title": "Connect",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.disconnect",
        "title": "Disconnect",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.status",
        "title": "Show Status",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.openChat",
        "title": "Open Web Chat (browser)",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.sendSelection",
        "title": "Send Selection to Agent",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.focusChat",
        "title": "Open",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.stopAllAgents",
        "title": "Stop all agents",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.resumeAgents",
        "title": "Resume agents",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.forgetAllowedFolders",
        "title": "Forget allowed folders",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.showActivityLog",
        "title": "Show activity log",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.checkForUpdates",
        "title": "Check for Updates",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.installUpdate",
        "title": "Install Offered Update",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.review.accept",
        "title": "Accept change",
        "category": "NanoClaw",
        "enablement": "nanoclaw.reviewing"
      },
      {
        "command": "nanoclaw.review.reject",
        "title": "Reject change",
        "category": "NanoClaw",
        "enablement": "nanoclaw.reviewing"
      },
      {
        "command": "nanoclaw.review.acceptAll",
        "title": "Accept all changes in file",
        "category": "NanoClaw",
        "enablement": "nanoclaw.reviewing"
      },
      {
        "command": "nanoclaw.review.rejectAll",
        "title": "Reject all changes in file",
        "category": "NanoClaw",
        "enablement": "nanoclaw.reviewing"
      },
      {
        "command": "nanoclaw.review.next",
        "title": "Next change",
        "category": "NanoClaw",
        "enablement": "nanoclaw.reviewing || nanoclaw.conflicted"
      },
      {
        "command": "nanoclaw.review.previous",
        "title": "Previous change",
        "category": "NanoClaw",
        "enablement": "nanoclaw.reviewing || nanoclaw.conflicted"
      },
      {
        "command": "nanoclaw.review.nextFile",
        "title": "Next file to review",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.finishUpdate",
        "title": "Finish Update",
        "category": "NanoClaw"
      },
      {
        "command": "nanoclaw.proposal.applyAll",
        "title": "Apply all",
        "category": "NanoClaw",
        "icon": "$(check-all)"
      },
      {
        "command": "nanoclaw.proposal.rejectAll",
        "title": "Reject all",
        "category": "NanoClaw",
        "icon": "$(discard)"
      },
      {
        "command": "nanoclaw.proposal.reviewAll",
        "title": "Review",
        "category": "NanoClaw",
        "icon": "$(eye)"
      },
      {
        "command": "nanoclaw.proposal.refresh",
        "title": "Refresh",
        "category": "NanoClaw",
        "icon": "$(refresh)"
      },
      {
        "command": "nanoclaw.proposal.apply",
        "title": "Apply",
        "category": "NanoClaw",
        "icon": "$(check)"
      },
      {
        "command": "nanoclaw.proposal.reject",
        "title": "Reject",
        "category": "NanoClaw",
        "icon": "$(discard)"
      },
      {
        "command": "nanoclaw.proposal.review",
        "title": "Review",
        "category": "NanoClaw",
        "icon": "$(eye)"
      },
      {
        "command": "nanoclaw.proposal.diff",
        "title": "Open Diff",
        "category": "NanoClaw",
        "icon": "$(diff)"
      }
    ],
    "configuration": {
      "title": "NanoClaw",
      "properties": {
        "nanoclaw.serverUrl": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "Central NanoClaw origin, e.g. https://<app>.azurewebsites.net"
        },
        "nanoclaw.signIn": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "microsoft",
            "network"
          ],
          "enumDescriptions": [
            "Sign in with Microsoft (Entra). For installs behind App Service authentication.",
            "No sign-in: central knows you by your network identity (Tailscale, or an identity-aware proxy)."
          ],
          "default": "microsoft",
          "description": "How this machine proves who you are to central. Central supplies it; set here to override."
        },
        "nanoclaw.appIdUri": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "Application ID URI of the App Service's Entra registration, e.g. api://<client-id>. The token's audience. Central supplies it; set here to override."
        },
        "nanoclaw.tenantId": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "Entra tenant ID (workforce tenant). Central supplies it; set here to override."
        },
        "nanoclaw.clientId": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "Optional: your own native app registration to sign in with (VSCODE_CLIENT_ID). Leave empty to use VS Code's Microsoft app. Central supplies it; set here to override."
        },
        "nanoclaw.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Connect on startup when signed in."
        },
        "nanoclaw.slots": {
          "scope": "machine",
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Project slots: maps a slot central declares (e.g. `/workspace/project`) to a local directory: the folder the agent's tools work on. A slot that is not bound here is refused."
        },
        "nanoclaw.mountAllowlist": {
          "scope": "machine",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Directories a slot may resolve into (symlinks followed). Empty = the folders open in this window."
        },
        "nanoclaw.workspaceMount": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "workspace",
            "off"
          ],
          "default": "workspace",
          "enumDescriptions": [
            "The open workspace folder (the one holding the active file, in a multi-root workspace) is the project the agent's tools work on.",
            "Never pick the workspace automatically; the project must be set in nanoclaw.slots."
          ],
          "markdownDescription": "Which folder the agent's tools work on. An explicit `nanoclaw.slots` entry for `/workspace/project` always wins."
        },
        "nanoclaw.workspaceExcludes": {
          "scope": "machine",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "secrets",
            "secret",
            ".secrets",
            ".env",
            ".env.*",
            "*.pem",
            "*.key",
            "*.pfx",
            "*.p12",
            "*.jks",
            "*.keystore",
            "id_rsa",
            "id_rsa.*",
            "id_ed25519",
            "id_ed25519.*",
            ".ssh",
            ".aws",
            ".azure",
            ".gnupg",
            ".npmrc",
            ".pypirc",
            ".netrc",
            ".git-credentials",
            "credentials.json",
            "service-account*.json",
            "terraform.tfstate",
            "terraform.tfstate.*",
            "*.env",
            ".envrc",
            ".kube",
            "kubeconfig",
            "id_ecdsa",
            "id_ecdsa.*",
            "id_dsa",
            "id_dsa.*",
            "*.ppk",
            "**/.docker/config.json",
            ".pgpass",
            ".htpasswd",
            ".vault-token",
            "*.tfstate",
            "*.tfstate.backup",
            "application_default_credentials.json",
            "settings.local.php",
            "wp-config.php",
            "*.kdbx"
          ],
          "markdownDescription": "Secret-like paths left out of the agent's copy of the project. Patterns are relative to the project root; a pattern without `/` matches a file or folder name anywhere; `*`, `?` and `**` are supported."
        },
        "nanoclaw.proposeIncludeIgnored": {
          "scope": "machine",
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also copy gitignored files into the agent's copy. Off: tracked and untracked (not ignored) files only."
        },
        "nanoclaw.proposeSecretScanAllow": {
          "scope": "machine",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Files copied into the agent's copy even when the secret scan finds a secret in them. Globs as in `nanoclaw.workspaceExcludes`."
        },
        "nanoclaw.releaseSigningKey": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "markdownDescription": "The operator's release signing key (`ed25519:…`). When set, runner updates must be signed by it, whatever central offers. Empty: the key central offers is pinned per server on your confirmation."
        },
        "nanoclaw.autoUpdate": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "prompt",
            "auto",
            "off"
          ],
          "default": "prompt",
          "enumDescriptions": [
            "Ask before installing a newer runner build that central serves.",
            "Install a newer build as soon as central announces it, then offer a reload.",
            "Never update from central."
          ],
          "markdownDescription": "How to handle a newer runner build that NanoClaw central serves. The package is downloaded over the same signed-in connection, its hash checked against what central announced, and installed through VS Code."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nanoclaw",
          "title": "NanoClaw",
          "icon": "media/nanoclaw.svg"
        }
      ]
    },
    "views": {
      "nanoclaw": [
        {
          "type": "webview",
          "id": "nanoclaw.chat",
          "name": "NanoClaw",
          "contextualTitle": "NanoClaw"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "nanoclaw.sendSelection",
          "group": "navigation@9",
          "when": "nanoclaw.connected"
        }
      ],
      "scm/title": [
        {
          "command": "nanoclaw.proposal.reviewAll",
          "group": "navigation@1",
          "when": "scmProvider == nanoclaw && nanoclaw.proposalReviewable"
        },
        {
          "command": "nanoclaw.proposal.applyAll",
          "group": "navigation@2",
          "when": "scmProvider == nanoclaw"
        },
        {
          "command": "nanoclaw.proposal.rejectAll",
          "group": "navigation@3",
          "when": "scmProvider == nanoclaw"
        },
        {
          "command": "nanoclaw.proposal.refresh",
          "group": "navigation@4",
          "when": "scmProvider == nanoclaw"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "nanoclaw.proposal.review",
          "group": "inline@1",
          "when": "scmProvider == nanoclaw && scmResourceState == reviewable && scmResourceState != conflict"
        },
        {
          "command": "nanoclaw.proposal.apply",
          "group": "inline@2",
          "when": "scmProvider == nanoclaw && scmResourceState != conflict"
        },
        {
          "command": "nanoclaw.proposal.reject",
          "group": "inline@3",
          "when": "scmProvider == nanoclaw && scmResourceState != conflict"
        },
        {
          "command": "nanoclaw.proposal.diff",
          "group": "navigation",
          "when": "scmProvider == nanoclaw && scmResourceState != conflict"
        }
      ],
      "commandPalette": [
        {
          "command": "nanoclaw.proposal.apply",
          "when": "false"
        },
        {
          "command": "nanoclaw.proposal.reject",
          "when": "false"
        },
        {
          "command": "nanoclaw.proposal.review",
          "when": "false"
        },
        {
          "command": "nanoclaw.proposal.diff",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nanoclaw.review.accept",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && nanoclaw.reviewing"
      },
      {
        "command": "nanoclaw.review.reject",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "editorTextFocus && nanoclaw.reviewing"
      },
      {
        "command": "nanoclaw.review.next",
        "key": "alt+f5",
        "mac": "alt+f5",
        "when": "editorTextFocus && (nanoclaw.reviewing || nanoclaw.conflicted)"
      },
      {
        "command": "nanoclaw.review.previous",
        "key": "shift+alt+f5",
        "mac": "shift+alt+f5",
        "when": "editorTextFocus && (nanoclaw.reviewing || nanoclaw.conflicted)"
      },
      {
        "command": "nanoclaw.review.nextFile",
        "key": "ctrl+alt+f5",
        "mac": "cmd+alt+f5",
        "when": "editorTextFocus && nanoclaw.reviewing"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run build && node scripts/package.mjs",
    "build:core": "tsc -p tsconfig.json",
    "harness:editor": "npm run build && npm run build:core && harness/editor-docker.sh"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.13",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ]
}
