+
+/**
+ * Parse a timestamp that may lack a zone marker as UTC. SQLite-style stamps
+ * (`YYYY-MM-DD HH:MM:SS`) carry no zone, and Date.parse reads those as LOCAL
+ * time — on a non-UTC host every claim looked (TZ offset) hours stale and the
+ * claim-stuck check killed freshly-claimed messages. Appends "Z" only when no
+ * marker is present, so an explicit Z or numeric offset is preserved.
+ */
+export function parseSqliteUtc(s: string): number {
+  return Date.parse(/[zZ]|[+-]\d{2}:?\d{2}$/.test(s) ? s : s + 'Z');
+}
+
+// After this many consecutive absolute-ceiling kills that produced NO new output,
+// treat the session as stuck resuming a continuation too large to process within
+// the ceiling (context bloat — every turn just recompacts and dies) and clear the
+// continuation so the next turn starts fresh.
+const CEILING_HEAL_STREAK = 2;
+
+/** What the sweep knew about a ceiling kill when it made it. */
+export interface CeilingKill {
+  /** Processing claims were open: a turn was stuck, not an idle container reaped. */
+  hadClaims: boolean;
+  /**
+   * Identifies the killed container incarnation, so a repeated kill of it
+   * counts once. Empty when unknown: then every kill counts.
+   */
+  incarnation: string;
+}
+
+/**
+ * The incarnation a ceiling kill is of, from the session claim's incarnation
+ * and the container's start time; empty when neither is known. Two kills
+ * with no ids would otherwise share one key (`:`) and count once, so the
+ * self-heal never fired for them.
+ */
+export function incarnationKey(claimIncarnation?: number | null, startedAtMs?: number | null): string {
+  if (claimIncarnation == null && startedAtMs == null) return '';
+  return `${claimIncarnation ?? ''}:${startedAtMs ?? ''}`;
+}
+
+/**
+ * Self-heal for a bloated continuation. Tracks, in the session's own outbound
+ * DB, how many ceiling kills in a row produced no output; at the streak
+ * threshold it clears every stored continuation so the next turn starts from a
+ * fresh session. Only a kill of a stuck turn counts, once per incarnation: an
+ * idle container past the ceiling is reaped by design and says nothing about
+ * its continuation. Returns true when it cleared. A caller that already holds the
+ * writable handle passes it in (tests do); otherwise one is opened and closed
+ * here. Best-effort: any failure here is
+ * logged and the sweep goes on — a kill already happened, this only decides
+ * whether the NEXT spawn resumes or restarts.
+ */
+export function selfHealBloatedContinuation(
+  session: Session,
+  kill: CeilingKill,
+  writableOutDb?: ReturnType<typeof openOutboundDbRw>,
+): boolean {
+  if (!kill.hadClaims) return false;
+  const ownsDb = !writableOutDb;
+  let db: ReturnType<typeof openOutboundDbRw> | null = writableOutDb ?? null;
+  try {
+    if (!db) db = openOutboundDbRw(outboundDbPath(session.agent_group_id, session.id));
+    db.exec(
+      `CREATE TABLE IF NOT EXISTS session_state (key TEXT PRIMARY KEY, value TEXT NOT NULL, updated_at TEXT NOT NULL)`,
+    );
+    const maxOut = (db.prepare('SELECT COALESCE(MAX(seq), 0) AS m FROM messages_out').get() as { m: number }).m;
+    const prevRaw = (
+      db.prepare("SELECT value FROM session_state WHERE key = '_ceiling_heal'").get() as { value: string } | undefined
+    )?.value;
+    let prev: { lastMaxOut: number; streak: number; incarnation?: string } | null = null;
+    try {
+      prev = prevRaw ? (JSON.parse(prevRaw) as { lastMaxOut: number; streak: number; incarnation?: string }) : null;
+    } catch {
+      prev = null;
+    }
+    if (prev && kill.incarnation && prev.incarnation === kill.incarnation) return false;
+    // Output advanced since the last kill (or this is the first kill) → the
+    // streak restarts at 1; otherwise it's another no-output kill in a row.
+    const streak = prev && maxOut <= prev.lastMaxOut ? prev.streak + 1 : 1;
+
+    if (streak >= CEILING_HEAL_STREAK) {
+      const cleared = db.prepare("DELETE FROM session_state WHERE key LIKE 'continuation:%'").run().changes;
+      db.prepare("DELETE FROM session_state WHERE key = '_ceiling_heal'").run();
+      log.warn('Self-heal: cleared bloated continuation after repeated no-output ceiling kills', {
+        sessionId: session.id,
+        streak,
+        continuationsCleared: cleared,
+      });
+      return true;
+    }
+    db.prepare("INSERT OR REPLACE INTO session_state (key, value, updated_at) VALUES ('_ceiling_heal', ?, ?)").run(
+      JSON.stringify({ lastMaxOut: maxOut, streak, incarnation: kill.incarnation }),
+      new Date().toISOString(),
+    );
+    return false;
+  } catch (err) {
+    log.warn('Self-heal continuation check failed', { sessionId: session.id, err });
+    return false;
+  } finally {
+    if (ownsDb) db?.close();
+  }
+}
