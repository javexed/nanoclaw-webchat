+import { describe, it, expect } from 'vitest';
+import { splitVaultSecrets, orphanSecretHints } from './setup/uninstall/onecli-agents.js';
+
+describe('splitVaultSecrets', () => {
+  const s = (id: string, name: string, host?: string) => ({ id, name, hostPattern: host ?? null });
+
+  it('claims a secret this install still tracks', () => {
+    const { mine, orphans } = splitVaultSecrets([s('a', 'UserCreds bob (grok)')], new Set(['a']));
+    expect(mine.map((x) => x.id)).toEqual(['a']);
+    expect(orphans).toEqual([]);
+  });
+
+  it('flags an untracked secret matching our naming as an orphan', () => {
+    // The 2026-08-21 case: survived a teardown, no DB row, still injected.
+    const { orphans } = splitVaultSecrets([s('d44', 'UserCreds webchat-local-owner (grok)')], new Set());
+    expect(orphans.map((x) => x.id)).toEqual(['d44']);
+  });
+
+  it('never touches a secret that is not ours by name', () => {
+    const { mine, orphans } = splitVaultSecrets([s('x', 'someone-elses-api-key')], new Set());
+    expect(mine).toEqual([]);
+    expect(orphans).toEqual([]);
+  });
+
+  it('prints a runnable command naming the host it injects on', () => {
+    const [line] = orphanSecretHints([s('d44', 'UserCreds bob (grok)', 'cli-chat-proxy.grok.com')]);
+    expect(line).toContain('onecli secrets delete --id d44');
+    expect(line).toContain('cli-chat-proxy.grok.com');
+  });
+});
