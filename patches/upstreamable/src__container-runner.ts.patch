+/**
+ * Consecutive spawn-failure count per session. A spawn failing once is normal
+ * (transient gateway blip, host-sweep retries); failing repeatedly means the
+ * agent genuinely can't start — almost always the OneCLI credential gateway
+ * being unreachable/misconfigured. Without this, host-sweep retries forever and
+ * the room just looks dead, which is the single worst OneCLI failure mode.
+ */
+const spawnFailures = new Map<string, number>();
+const SPAWN_FAILURE_NOTICE_AT = 3;
+
+/**
+ * Record a failed spawn for a session; once it crosses the threshold, post ONE
+ * persistent notice into the room so the silence is explained and an admin
+ * knows to look. Reset on the next successful spawn (re-arms the notice for a
+ * future outage). Best-effort — never throws into the wake path.
+ */
+async function noteSpawnFailure(session: Session, err?: unknown): Promise<void> {
+  const n = (spawnFailures.get(session.id) ?? 0) + 1;
+  spawnFailures.set(session.id, n);
+  if (n !== SPAWN_FAILURE_NOTICE_AT) return; // fire exactly once per outage
+  try {
+    const mg = await (session.messaging_group_id ? getMessagingGroup(session.messaging_group_id) : undefined);
+    if (!mg || !mg.platform_id) return; // nowhere to post (e.g. agent-only session)
+    await writeOutboundDirect(session.agent_group_id, session.id, {
+      id: `spawn-fail-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
+      kind: 'chat',
+      platformId: mg.platform_id,
+      channelType: mg.channel_type,
+      threadId: session.thread_id ?? null,
+      content: JSON.stringify({ text: spawnFailureNotice(err) }),
+    });
+    // The room gets a category; the full reason (it can name local paths) stays here.
+    const detail = (err as { detail?: unknown } | null | undefined)?.detail;
+    log.warn('Posted spawn-failure notice to room after repeated failures', {
+      sessionId: session.id,
+      failures: n,
+      kind: (err as { kind?: unknown } | null | undefined)?.kind,
+      detail: typeof detail === 'string' ? detail : undefined,
+      err: err instanceof Error ? err.message : undefined,
+    });
+  } catch (err) {
+    log.warn('Failed to post spawn-failure notice', { sessionId: session.id, err });
+  }
+}
+
+/**
+ * The room notice for a spawn that keeps failing. "Runtime unavailable" is
+ * the container runtime not answering, and blaming the credential gateway for
+ * it sent people looking in the wrong place.
+ */
+export function spawnFailureNotice(err: unknown): string {
+  const kind = (err as { kind?: unknown } | null | undefined)?.kind;
+  // A refusal carries its reason, but that reason can name paths on this
+  // host; every room member reads this line. So the room gets
+  // a short category, and the full reason goes to the log (noteSpawnFailure).
+  if (kind === 'image-unavailable') {
+    return `⚠️ I couldn't start to handle that — the agent image isn't ready yet. I'll start once it is.`;
+  }
+  if (kind === 'denied-by-policy' || kind === 'spec-invalid') {
+    const category = kind === 'denied-by-policy' ? 'policy' : 'invalid session setup';
+    return `⚠️ I couldn't start to handle that — my start was refused (${category}). An admin can find the reason in the logs; I'll keep retrying.`;
+  }
+  if (kind === 'runtime-unavailable') {
+    return "⚠️ I couldn't start to handle that — the container runtime isn't reachable right now. I’ll start as soon as it’s back.";
+  }
+  return (
+    "⚠️ I couldn't start to handle that — this usually means the credential gateway is " +
+    'unreachable or misconfigured. An admin may need to check it; I’ll keep retrying and reply once it’s back.'
+  );
+}
