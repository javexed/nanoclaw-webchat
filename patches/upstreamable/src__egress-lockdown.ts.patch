+/** The lockdown network's host-side address: where central's egress filter listens. */
+export function egressBridgeAddress(): string {
+  const out = execFileSync(
+    CONTAINER_RUNTIME_BIN,
+    ['network', 'inspect', EGRESS_NETWORK, '--format', '{{range .IPAM.Config}}{{.Gateway}} {{end}}'],
+    { stdio: ['pipe', 'pipe', 'pipe'], encoding: 'utf-8', timeout: 15000 },
+  );
+  const ip = out
+    .trim()
+    .split(/\s+/)
+    .find((x) => /^\d+\.\d+\.\d+\.\d+$/.test(x));
+  if (!ip)
+    throw new EgressLockdownError(`the "${EGRESS_NETWORK}" network has no IPv4 gateway address for the egress filter`);
+  return ip;
