+/**
+ * Would this click be accepted? Same rule handleApprovalsResponse enforces,
+ * exposed so a channel that can answer its caller (the webchat route returns
+ * HTTP) can refuse with a REASON instead of accepting the request and
+ * discarding it.
+ *
+ * handleApprovalsResponse is reached through the fire-and-forget
+ * `onAction` hook, which returns void through three layers — by the time it
+ * decides, the route has already replied 200. That is why an unauthorized
+ * click used to do nothing at all, visibly: the refusal existed only as a
+ * server log line.
+ */
+export async function checkApprovalClick(payload: ResponsePayload): Promise<ApprovalClickCheck> {
+  const approval = await getPendingApproval(payload.questionId);
+  if (!approval) return { ok: false, reason: 'This request is no longer awaiting a decision.' };
+  if (await isAuthorizedApprovalClick(approval, payload)) return { ok: true };
+  return {
+    ok: false,
+    reason: approval.approver_user_id
+      ? `This request is assigned to ${approval.approver_user_id}. Only they, or an owner, can decide it.`
+      : 'You do not have permission to decide this request.',
+  };
+}
