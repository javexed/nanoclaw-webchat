diff --git a/container/Dockerfile b/container/Dockerfile
index 6d181d85..e8e8f2cd 100644
--- a/container/Dockerfile
+++ b/container/Dockerfile
@@ -58,6 +58,7 @@ RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
         ca-certificates \
         curl \
         git \
+        openssh-client \
         poppler-utils \
         tini \
         unzip \
@@ -119,11 +120,36 @@ COPY cli-tools.json install-cli-tools.sh /tmp/
 RUN --mount=type=cache,target=/root/.cache/pnpm \
     sh /tmp/install-cli-tools.sh /tmp/cli-tools.json
 
+# ---- rtk (token-compression proxy, invoked via the PreToolUse hook) ----------
+# Compresses Bash tool output before it reaches the model (the hook itself is
+# seeded by group-init's default settings.json). Baked into the image (NOT
+# mounted) because mount-security rejects absolute container mount paths.
+# Arch-aware: x86_64 ships a static musl build; arm64 (Raspberry Pi, ARM VMs)
+# ships gnu — the node:22-slim base is glibc either way.
+ARG RTK_VERSION=v0.44.1
+RUN case "$(uname -m)" in \
+      x86_64)  RTK_TRIPLE=x86_64-unknown-linux-musl ;; \
+      aarch64) RTK_TRIPLE=aarch64-unknown-linux-gnu ;; \
+      *) echo "rtk: unsupported arch $(uname -m)" >&2 && exit 1 ;; \
+    esac && \
+    curl -fsSL "https://github.com/rtk-ai/rtk/releases/download/${RTK_VERSION}/rtk-${RTK_TRIPLE}.tar.gz" -o /tmp/rtk.tar.gz && \
+    tar -xzf /tmp/rtk.tar.gz -C /usr/local/bin rtk && \
+    chmod +x /usr/local/bin/rtk && \
+    rm -f /tmp/rtk.tar.gz && \
+    /usr/local/bin/rtk --version
+
 # ---- ncl CLI wrapper ----------------------------------------------------------
 # Actual script lives in the mounted source at /app/src/cli/ncl.ts.
 RUN printf '#!/bin/sh\nexec bun /app/src/cli/ncl.ts "$@"\n' > /usr/local/bin/ncl && \
     chmod +x /usr/local/bin/ncl
 
+# ---- SSH ---------------------------------------------------------------------
+# Deploy keys: the host mounts a read-only view at /run/nanoclaw-ssh (Host
+# entries, pinned host keys, its ssh-agent socket; never a private key), so a
+# plain `ssh <name>` works. A missing file is ignored by Include. Destination-
+# constrained keys need OpenSSH 8.9 or later on this side (bookworm: 9.2).
+RUN printf 'Include /run/nanoclaw-ssh/config\n' > /etc/ssh/ssh_config.d/50-nanoclaw.conf
+
 # ---- Entrypoint --------------------------------------------------------------
 COPY entrypoint.sh /app/entrypoint.sh
 RUN chmod +x /app/entrypoint.sh
@@ -133,6 +159,14 @@ RUN mkdir -p /workspace/group /workspace/extra && \
     chown -R node:node /workspace && \
     chmod 777 /home/node
 
+# >>> nanoclaw:image-layers
+# Skills insert extra image layers here with `nc:append at:nanoclaw:image-layers`
+# instead of replacing this file, so a skill payload can never roll back the
+# recipe above. Layers land as root, ahead of the setuid strip and the switch to
+# the unprivileged user below. Keep inserted lines unique: the engine's undo
+# deletes every line matching one a skill added, anywhere in this file.
+# <<< nanoclaw:image-layers
+
 # Drop setuid-root from the binaries Debian ships (mount, su, passwd, ...). The
 # agent runs unprivileged and needs none of them.
 RUN find / -xdev -perm -4000 -type f -exec chmod u-s {} + || true
