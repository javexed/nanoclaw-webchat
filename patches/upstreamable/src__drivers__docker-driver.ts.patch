@@ -712,10 +728,26 @@ export function ensureDockerRunning(cli: Cli = realCli('docker')): void {
     console.error('\n╔════════════════════════════════════════════════════════════════╗');
     console.error('║  FATAL: Container runtime failed to start                      ║');
     console.error('║                                                                ║');
