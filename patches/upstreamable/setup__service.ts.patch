--- a/setup/service.ts
+++ b/setup/service.ts
@@ -302,6 +302,12 @@ function setupSystemd(projectRoot: string, nodePath: string, homeDir: string): v
     systemctlPrefix = 'systemctl --user';
   }
 
+  // /snap/bin is on the PATH so snap-packaged CLIs the host shells out to
+  // resolve — notably `tailscale` on Ubuntu, where the snap is the default
+  // install. A login shell picks /snap/bin up from /etc/profile.d, but a
+  // systemd service gets none of that, so an omitted entry means the host
+  // can't exec `tailscale` and webchat reports HTTPS-over-Tailscale as
+  // unavailable even while the tailnet is up.
   const unit = `[Unit]
 Description=NanoClaw Personal Assistant
 After=network.target
@@ -314,7 +320,7 @@ Restart=always
