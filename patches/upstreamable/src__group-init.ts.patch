+const PRE_COMPACT_HOOK = { hooks: [{ type: 'command', command: 'bun /app/src/compact-instructions.ts' }] };
+
+// rtk compresses Bash tool output before it reaches the model. The binary is
+// baked into the agent image (container/Dockerfile); a failing/absent hook
+// command is non-blocking for the tool call.
+export const RTK_HOOK = { matcher: 'Bash', hooks: [{ type: 'command', command: 'rtk hook claude' }] };
+
+/**
+ * Patch an existing settings.json to add a hook entry if its command is
+ * missing. Runs on every group init so pre-existing groups pick up the hook;
+ * preserves whatever other hooks the operator has, never breaks init on
+ * malformed JSON. Exported for the wiring test.
+ */
+export function ensureHook(
+  settingsFile: string,
+  initialized: string[],
+  event: 'PreCompact' | 'PreToolUse',
+  entry: { hooks: { command: string }[] },
+  label: string,
+): void {
+  try {
+    const raw = fs.readFileSync(settingsFile, 'utf-8');
+    const settings = JSON.parse(raw);
+
+    // Check if there's already a hook with our command.
+    const existing = settings.hooks?.[event] as unknown[] | undefined;
+    if (existing && JSON.stringify(existing).includes(entry.hooks[0].command)) return;
+
+    // Add the hook, preserving existing hooks.
+    if (!settings.hooks) settings.hooks = {};
+    if (!settings.hooks[event]) settings.hooks[event] = [];
+    settings.hooks[event].push(entry);
+
+    fs.writeFileSync(settingsFile, JSON.stringify(settings, null, 2) + '\n');
+    initialized.push(`settings.json (added ${label})`);
+  } catch {
+    // Don't break init if settings.json is malformed — it'll use whatever's there.
+  }
+}
