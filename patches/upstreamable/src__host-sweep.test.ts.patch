+describe('selfHealBloatedContinuation', () => {
+  function outDbWith(maxOutSeq: number | null): Database.Database {
+    const db = new Database(':memory:');
+    db.exec(`
+      CREATE TABLE messages_out (seq INTEGER);
+      CREATE TABLE session_state (key TEXT PRIMARY KEY, value TEXT NOT NULL, updated_at TEXT NOT NULL);
+    `);
+    if (maxOutSeq !== null) db.prepare('INSERT INTO messages_out (seq) VALUES (?)').run(maxOutSeq);
+    db.prepare("INSERT INTO session_state VALUES ('continuation:claude', 'sess-abc', ?)").run(new Date().toISOString());
+    return db;
+  }
+  const healRow = (db: Database.Database) => {
+    const r = db.prepare("SELECT value FROM session_state WHERE key = '_ceiling_heal'").get() as
+      | { value: string }
+      | undefined;
+    return r ? (JSON.parse(r.value) as { lastMaxOut: number; streak: number; incarnation?: string }) : undefined;
+  };
+  const hasContinuation = (db: Database.Database) =>
+    db.prepare("SELECT 1 FROM session_state WHERE key = 'continuation:claude'").get() !== undefined;
+
+  const stuck = (incarnation: string) => ({ hadClaims: true, incarnation });
+
+  it('does not clear on the first no-output ceiling kill — just records streak=1', async () => {
+    const db = outDbWith(2409);
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('1:100'), db)).toBe(false);
+    expect(hasContinuation(db)).toBe(true);
+    expect(healRow(db)).toEqual({ lastMaxOut: 2409, streak: 1, incarnation: '1:100' });
+  });
+
+  it('clears the continuation on the SECOND consecutive no-output ceiling kill', async () => {
+    const db = outDbWith(2409);
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('1:100'), db)).toBe(false); // 1st
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('2:200'), db)).toBe(true); // 2nd, no new output
+    expect(hasContinuation(db)).toBe(false);
+    expect(healRow(db)).toBeUndefined(); // heal state reset
+  });
+
+  it('resets the streak when a reply landed between kills — never clears a productive session', async () => {
+    const db = outDbWith(2409);
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('1:100'), db)).toBe(false);
+    db.prepare('INSERT INTO messages_out (seq) VALUES (2411)').run(); // a real reply advanced the seq
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('2:200'), db)).toBe(false); // output advanced → streak restarts
+    expect(hasContinuation(db)).toBe(true);
+    expect(healRow(db)).toEqual({ lastMaxOut: 2411, streak: 1, incarnation: '2:200' });
+  });
+
+  it('never counts an idle reap — no open claims means nothing was stuck', async () => {
+    const db = outDbWith(2409);
+    const idle = (incarnation: string) => ({ hadClaims: false, incarnation });
+    expect(selfHealBloatedContinuation(fakeSession(), idle('1:100'), db)).toBe(false);
+    expect(selfHealBloatedContinuation(fakeSession(), idle('2:200'), db)).toBe(false);
+    expect(selfHealBloatedContinuation(fakeSession(), idle('3:300'), db)).toBe(false);
+    expect(hasContinuation(db)).toBe(true);
+    expect(healRow(db)).toBeUndefined();
+  });
+
+  it('an idle reap between two stuck kills neither counts nor resets the streak', async () => {
+    const db = outDbWith(2409);
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('1:100'), db)).toBe(false);
+    expect(selfHealBloatedContinuation(fakeSession(), { hadClaims: false, incarnation: '2:200' }, db)).toBe(false);
+    expect(healRow(db)).toEqual({ lastMaxOut: 2409, streak: 1, incarnation: '1:100' });
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('3:300'), db)).toBe(true);
+  });
+
+  it('repeat kills of the same container count once', async () => {
+    const db = outDbWith(2409);
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('1:100'), db)).toBe(false);
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('1:100'), db)).toBe(false);
+    expect(selfHealBloatedContinuation(fakeSession(), stuck('1:100'), db)).toBe(false);
+    expect(hasContinuation(db)).toBe(true);
+    expect(healRow(db)).toEqual({ lastMaxOut: 2409, streak: 1, incarnation: '1:100' });
+  });
+});
