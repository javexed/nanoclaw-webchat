+/** A path strictly inside DATA_DIR, compared lexically (both sides resolved). */
+function isInsideDataDir(p: string): boolean {
+  const rel = path.relative(path.resolve(DATA_DIR), path.resolve(p));
+  return rel !== '' && !rel.startsWith('..') && !path.isAbsolute(rel);
+}
+
+/**
+ * Copy a staged upload into the inbox through the anchored handle, so it gets
+ * the same guarantees as inline bytes: the target is created exclusively and
+ * never through a symlink, in the directory that was checked. The source must
+ * be a regular file (no symlink, no FIFO), and is streamed rather than read
+ * whole — these are the uploads too large to inline.
+ */
+function copyIntoInbox(inbox: AnchoredDir, filename: string, source: string): void {
+  const src = fs.openSync(source, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
+  try {
+    if (!fs.fstatSync(src).isFile()) throw new Error(`refusing attachment source '${source}': not a regular file`);
+    const dst = inbox.openNewFd(filename);
+    try {
+      const buf = Buffer.allocUnsafe(1 << 20);
+      for (let n = fs.readSync(src, buf, 0, buf.length, null); n > 0; n = fs.readSync(src, buf, 0, buf.length, null)) {
+        fs.writeSync(dst, buf, 0, n);
+      }
+    } finally {
+      fs.closeSync(dst);
+    }
+  } finally {
+    fs.closeSync(src);
+  }
+}
