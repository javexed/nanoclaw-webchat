+/**
+ * Capability lookup by provider name, same contract as
+ * providerProvidesAgentSurfaces: an unregistered provider reports nothing and
+ * is therefore assumed to HAVE MCP tools — which is true of every provider but
+ * pi, and is what the host did before this existed.
+ */
+export function providerLacksMcpTools(name: string | null | undefined): boolean {
+  if (!name) return false;
+  return registry.get(name)?.capabilities.lacksMcpTools === true;
+}
