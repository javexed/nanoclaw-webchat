+/**
+ * The origin of ONE inbound row.
+ *
+ * extractRouting deliberately collapses a batch to a single origin, which is
+ * right for a turn's reply but wrong for anything answering an individual row:
+ * one poll can carry rows from several rooms, so a per-row response addressed
+ * to the batch origin lands in whichever room sorted first. Runner commands
+ * (/clear, /upload-trace) confirm per row and must use this instead.
+ */
+export function originOf(message: MessageInRow): Pick<MessageInRow, 'platform_id' | 'channel_type' | 'thread_id'> {
+  return {
+    platform_id: message.platform_id,
+    channel_type: message.channel_type,
+    thread_id: message.thread_id,
+  };
+}
