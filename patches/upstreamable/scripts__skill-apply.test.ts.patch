+/**
+ * Every scratch dir this file makes, removed when the file finishes.
+ *
+ * beforeEach creates a fresh skill + project pair per test and nothing removed
+ * them, so one run of this file left ~200 dirs under os.tmpdir() and a full
+ * suite left tens of thousands. On a tmpfs /tmp that exhausts INODES while df
+ * still reports gigabytes free, and every later write fails with ENOSPC — which
+ * surfaces as unrelated tests "failing" for no visible reason.
+ */
+const SCRATCH: string[] = [];
+function scratchDir(prefix: string): string {
+  const d = mkdtempSync(join(tmpdir(), prefix));
+  SCRATCH.push(d);
+  return d;
+}
+afterAll(() => {
+  for (const d of SCRATCH) rmSync(d, { recursive: true, force: true });
+  SCRATCH.length = 0;
+});
+
