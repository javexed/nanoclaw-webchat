+/**
+ * Every scratch dir this file makes, removed when the file finishes.
+ *
+ * These tests created ~20 dirs under os.tmpdir() per run and removed none, so a
+ * full suite left thousands behind. On a tmpfs /tmp that is an INODE leak, not a
+ * disk one: the filesystem reports gigabytes free while every write fails with
+ * ENOSPC. It is a nasty way to be wrong — a run in that state reported 32 test
+ * failures that all passed once the inodes were freed.
+ */
+const SCRATCH: string[] = [];
+function scratchDir(prefix: string): string {
+  const d = mkdtempSync(join(tmpdir(), prefix));
+  SCRATCH.push(d);
+  return d;
+}
+afterAll(() => {
+  for (const d of SCRATCH) rmSync(d, { recursive: true, force: true });
+  SCRATCH.length = 0;
+});
+
