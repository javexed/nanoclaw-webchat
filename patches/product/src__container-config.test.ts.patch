+
+  /**
+   * Egress is the one config field where a missing line is SILENT: the column,
+   * the `ncl --egress` flag and the container-runner branch all exist, so the
+   * setting stores and reads back fine — it just never reaches the spawn, and
+   * every group runs with open egress regardless. Nothing else catches that,
+   * which is how it shipped unmapped.
+   */
+  it('configFromDb carries egress through to the container', async () => {
+    await updateContainerConfigScalars(GROUP.id, { egress: 'host-only' });
+    expect(configFromDb((await getContainerConfig(GROUP.id))!, GROUP).egress).toBe('host-only');
+
+    await updateContainerConfigScalars(GROUP.id, { egress: 'none' });
+    expect(configFromDb((await getContainerConfig(GROUP.id))!, GROUP).egress).toBe('none');
+
+    // Unset means OneCLI's default (open) — undefined, not the string 'open'.
+    await updateContainerConfigScalars(GROUP.id, { egress: null });
+    expect(configFromDb((await getContainerConfig(GROUP.id))!, GROUP).egress).toBeUndefined();
+  });
 });
 
