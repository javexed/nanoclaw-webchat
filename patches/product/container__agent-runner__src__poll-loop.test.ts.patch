+// The turn-retry seam (R5) is consulted from TWO sites, and the split matters:
+// upstream an SDK failure throws, so only the catch path exists — but this
+// tree's claude.ts catches those and re-emits them as `type:'error'` events,
+// which arrive as a terminalError RESULT instead. That is the common shape
+// here, so a seam wired only to the catch path would essentially never fire.
+// It shipped that way: the existing R5 test exercises the registry
+// (first-non-null, throwers skipped) without ever driving the loop, so nothing
+// caught it. These two drive runPollLoop for real, one per failure shape.
+describe('turn-retry seam wiring — both failure shapes reach the handler', () => {
+  async function driveFailure(response: unknown): Promise<string[]> {
+    const restore = __snapshotRunnerHooksForTest();
+    try {
+      const fired: string[] = [];
+      registerTurnRetryHandler(async (ctx) => {
+        fired.push(ctx.failure.message);
+        return null; // decline — core keeps its normal error path
+      });
+      getInboundDb()
+        .prepare(
+          `INSERT INTO messages_in (id, kind, timestamp, status, platform_id, channel_type, thread_id, content)
+           VALUES ('m-retry', 'chat', datetime('now'), 'pending', 'chan-1', 'discord', 'thread-1', ?)`,
+        )
+        .run(JSON.stringify({ sender: 'Alice', text: 'hello' }));
+      const controller = new AbortController();
+      const provider = new MockProvider({}, () => response as never);
+      await Promise.race([
+        runPollLoop({ provider, providerName: 'mock', cwd: '/tmp', signal: controller.signal }),
+        new Promise<void>((r) => setTimeout(r, 1500)),
+      ]);
+      controller.abort();
+      return fired;
+    } finally {
+      restore();
+    }
+  }
+
+  it('a THROWN provider failure reaches the handler', async () => {
+    expect(await driveFailure({ throw: 'SDK died mid-stream' })).toEqual(['SDK died mid-stream']);
+  });
+
+  it('an ERROR-EVENT failure reaches the handler (the shape claude.ts emits)', async () => {
+    expect(
+      await driveFailure({
+        error: { message: 'model not found: qwen3', retryable: false, classification: 'config' },
+      }),
+    ).toEqual(['model not found: qwen3']);
+  });
+});
