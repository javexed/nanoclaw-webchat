+ *   - `approved`: told to the agent once the approved command has run, in
+ *     place of the raw result.
+ */
+export interface ApprovalWords {
+  pending?: (ctx: CallerContext) => Promise<string | undefined>;
+  approved?: (outcome: { approvalId: string; frame: RequestFrame; response: ResponseFrame }) => string | undefined;
+}
+
+let approvalWords: ApprovalWords = {};
+
+export function registerApprovalWords(words: ApprovalWords): void {
+  approvalWords = words;
+}
+
+/** The installed pending note, or undefined. Never throws. */
+export async function approvalPendingWords(ctx: CallerContext): Promise<string | undefined> {
+  try {
+    return (await approvalWords.pending?.(ctx)) || undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/** The installed words for an approved command's outcome, or undefined. Never throws. */
+export function approvedResultWords(outcome: {
+  approvalId: string;
+  frame: RequestFrame;
+  response: ResponseFrame;
+}): string | undefined {
+  try {
+    return approvalWords.approved?.(outcome) || undefined;
+  } catch {
+    return undefined;
+  }
+}
