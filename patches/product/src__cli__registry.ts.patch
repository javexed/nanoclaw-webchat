+/**
+ * What a precheck may add to an approval card. The command line with every
+ * argument stays on the card below it; this only adds words above.
+ */
+export interface PrecheckResult {
+  /** Card title in place of `CLI: <command>`. */
+  title?: string;
+  /** Plain-language card text; `{agent}` becomes the agent's quoted name. Untrusted values must be quoted already. */
+  summary?: string;
+  /** More lines under the summary (what will run). */
+  detail?: string;
+  /**
+   * Values joined into the approved arguments (they win over the agent's own
+   * and show on the card), so the handler can refuse when what it is about to
+   * do is not what the card showed.
+   */
